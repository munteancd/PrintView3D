# PyInstaller build recipe for PrintView3D.
# Build with:  pyinstaller --noconfirm --clean printview3d.spec
# (build_windows.bat does this for you)

import os
import re
import sys
from PyInstaller.utils.hooks import collect_submodules

# Windows file properties (Details tab): always the version from
# src/printview3d/__init__.py, so every build carries the right version.
VERSION = re.search(r'__version__ = "(.+?)"', open("src/printview3d/__init__.py", encoding="utf-8").read()).group(1)
_nums = tuple((int(x) for x in re.findall(r"\d+", VERSION)[:4])) + (0,) * 4
_v4 = _nums[:4]
VERSION_FILE = os.path.join("build", "version_info.txt")
os.makedirs("build", exist_ok=True)
with open(VERSION_FILE, "w", encoding="utf-8") as _f:
    _f.write(f"""# UTF-8 - generated by printview3d.spec, do not edit
VSVersionInfo(
  ffi=FixedFileInfo(filevers={_v4}, prodvers={_v4}, mask=0x3f, flags=0x0,
                    OS=0x40004, fileType=0x1, subtype=0x0, date=(0, 0)),
  kids=[
    StringFileInfo([StringTable('040904B0', [
      StringStruct('CompanyName', 'PrintView3D contributors'),
      StringStruct('FileDescription', 'PrintView3D - 3D print file viewer'),
      StringStruct('FileVersion', '{VERSION}'),
      StringStruct('InternalName', 'PrintView3D'),
      StringStruct('LegalCopyright', 'MIT License'),
      StringStruct('OriginalFilename', 'PrintView3D.exe'),
      StringStruct('ProductName', 'PrintView3D'),
      StringStruct('ProductVersion', '{VERSION}')])]),
    VarFileInfo([VarStruct('Translation', [1033, 1200])])
  ]
)
""")

hiddenimports = (
    collect_submodules("pyvistaqt")
    + collect_submodules("vtkmodules.qt")
    + [
        "qtpy", "qtpy.QtCore", "qtpy.QtGui", "qtpy.QtWidgets",
        "vtkmodules.util.numpy_support", "certifi",
    ]
)

from PyInstaller.utils.hooks import collect_data_files

a = Analysis(
    ["src/printview3d/__main__.py"],
    pathex=["src"],
    datas=[("src/printview3d/resources", "printview3d/resources")] + collect_data_files("certifi"),
    hiddenimports=hiddenimports,
    excludes=[
        # Not needed and large; keeps the build smaller.
        "PyQt5", "PyQt6", "PySide2", "tkinter", "IPython", "jupyter", "trame",
        "pytest", "scipy", "pandas", "cv2", "imageio", "imageio_ffmpeg", "cryptography",
        "PySide6.QtWebEngineCore", "PySide6.QtWebEngineWidgets", "PySide6.Qt3DCore",
        "PySide6.QtQuick", "PySide6.QtQml", "PySide6.QtMultimedia", "PySide6.QtPdf",
        "PySide6.QtCharts", "PySide6.QtDataVisualization", "PySide6.QtBluetooth",
    ],
    noarchive=False,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="PrintView3D",
    icon="src/printview3d/resources/icon.ico",
    console=False,
    upx=False,
    version=VERSION_FILE if sys.platform == "win32" else None,
)
coll = COLLECT(exe, a.binaries, a.datas, name="PrintView3D", upx=False)
